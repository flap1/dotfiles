#!/bin/sh
# Copied into a new repository by git init (init.templatedir).
# This is not core.hooksPath. A global hooksPath replaces every repo's
# hooks — clones included — and lefthook 2.x refuses to install when one
# is set (evilmartians/lefthook#1248, #1371). Gates for *this* repository
# live in lefthook.yml and are installed into .git/hooks here only.

email=$(git config --get user.email || true)
if [ -z "$email" ]; then
    echo "git: user.email is empty. Set it in ~/.gitconfig.local" >&2
    exit 1
fi
