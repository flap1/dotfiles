## bin
# mise provides these; a tracked symlink to /usr/bin is a machine path.
/bin/fd
/bin/bat

## neovim
/.config/nvim/plugin/**
/.config/nvim/lua/local.lua

## zsh
/.config/zsh/.zcompdump
/.config/zsh/.zcompcache
/.config/zsh/.zshrc.local
/.config/zsh/init

## background
/.config/pictures/**

## claude
/.claude/skills/st-plan/.cache
/.claude/skills/st/.cache
# Upstream trees listed in .claude/skills/VENDOR. Installed by
# `npx skills update -g`, replaced wholesale, never committed.
/.claude/skills/hallmark/

## private / machine-local overrides
# This repo is public. Anything naming an employer, an internal host path or a
# credential lives in these instead, and they are never tracked.
/.claude/settings.local.json
/.claude/PROMPT.md
/.claude/CLAUDE.md
/.claude/RTK.md
/.claude/hooks/st-backpressure.sh
/.config/git/.gitconfig.local
/.cursor/cli-config.local.json

## this machine only — not part of a clone
/bin/ci-cache-reap.sh
/bin/pr-conflicts
/lib/bind-localhost.c
/lib/test-bind-localhost.sh

## VSCode: retired in favour of the terminal stack, and its remote-SSH host
## map names the employer.
/.config/Code/**

## lazygit runtime state (recent repo list), not config
/.config/lazygit/state.yml
## superseded hook backup
/.git_template/hooks/*.old

## local index from the code-review-graph MCP; not configuration
/.code-review-graph/
