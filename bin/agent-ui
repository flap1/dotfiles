#!/bin/sh
# Install the pinned agent UI.

set -eu

repo=${XDG_DATA_HOME:-"$HOME/.local/share"}/agent-ui
source=git@github.com:flap1/agent-ui.git
commit=8b5d5c9b821380bdcdc95d3048ad8d28ff790814

if [ ! -d "$repo/.git" ]; then
    git clone --no-checkout "$source" "$repo"
fi

git -C "$repo" remote set-url origin "$source"
git -C "$repo" fetch origin "$commit"
git -C "$repo" checkout --detach --force "$commit"
(cd "$repo/tools" && cargo build --release -p ai-usage)
mkdir -p "$HOME/.local/bin"
install -m 0755 "$repo/tools/target/release/ai-usage" "$HOME/.local/bin/ai-usage"

printf 'Installed agent UI at %s\n' "$commit"
