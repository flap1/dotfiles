#!/bin/bash

# Remove a submodule and every trace git keeps of it.
if [ -z "$1" ]; then
    echo "Usage: $0 <path>"
    exit 1
fi

path="$1"

if [ -f ".gitmodules" ]; then
    echo "remove it from .gitmodules? (y/n): "
    read -r confirm_gitmodules
    if [[ $confirm_gitmodules == "y" ]]; then
        git config --file=.git/config --remove-section "submodule.$path" || {
            echo "Error: Failed to remove submodule from .git/config."
            exit 1
        }
        git config -f .gitmodules --remove-section "submodule.$path" || {
            echo "Error: Failed to remove submodule from .gitmodules."
            exit 1
        }
        git rm --cached -rf "$path" || {
            echo "Error: Failed to remove submodule from the repository."
            exit 1
        }
    fi
fi

if [ -f ".git/config" ]; then
    echo "remove it from .git/config? (y/n): "
    read -r confirm_config
    if [[ $confirm_config == "y" ]]; then
        git config --file=.git/config --remove-section "submodule.$path" || {
            echo "Error: Failed to remove submodule from .git/config."
            exit 1
        }
        git rm --cached -rf "$path" || {
            echo "Error: Failed to remove submodule from the repository."
            exit 1
        }
    fi
fi

if [ -d ".git/modules/$path" ]; then
    echo "remove .git/modules/$path? (y/n): "
    read -r confirm_modules
    if [[ $confirm_modules == "y" ]]; then
        rm -rf ".git/modules/$path" || {
            echo "Error: Failed to remove submodule from .git/modules directory."
            exit 1
        }
    fi
fi

echo "remove the path '$path'? (y/n): "
read -r confirm_path
if [[ $confirm_path == "y" ]]; then
    rm -rf "$path" || {
        echo "Error: Failed to remove the specified path."
        exit 1
    }
    git rm --cached -rf "$path" || {
        echo "Error: Failed to remove the specified path from the repository."
        exit 1
    }
fi

echo "done"
