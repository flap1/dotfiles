#!/bin/bash

output_directory_name="out"
source_directory_name='tex'
texfile="$1"

# get current dir of texfile
current_directory=$(dirname "$texfile")
current_directory_name=$(basename "$current_directory")
parent_directory=$(dirname "$current_directory")
if [ $current_directory_name = $source_directory_name ]; then
  output_directory=$parent_directory/$output_directory_name
elif [ -d $current_directory/$source_directory_name ]; then
  output_directory=$current_directory/$output_directory_name
else
  output_directory=$current_directory/$output_directory_name
fi

mkdir -p $output_directory
latexmk -pdfdvi -verbose -file-line-error -output-directory=$output_directory $texfile"/tmptex.tex"
rm $texfile"/tmptex.tex"

