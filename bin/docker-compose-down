#!/bin/bash

# ヘルプメッセージを表示する関数
show_help() {
  echo "Usage: $0 [service_name]"
  echo "This script removes Docker services using 'docker-compose rm -fsv' for the specified service."
}

# 第一引数がない場合はヘルプを表示して終了
if [ -z "$1" ]; then
  show_help
  exit 1
fi

# サービス名を取得
service_name="$1"

# サービスが存在するか確認
if ! docker-compose config --services | grep -q "^$service_name$"; then
  echo "Service not found: $service_name"
  show_help
  exit 1
fi

# docker-compose rm -fsv を実行
docker-compose rm -fsv "$service_name"

