#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: $0 <length>"
    echo "Specify the length as the first argument."
    exit 1
fi

length="$1"

password=$(tr -dc '[:alnum:][:punct:]' </dev/urandom | head -c "$length")
echo "Generated Password: $password"

# Ask whether to copy the password to the clipboard
read -r -p "Do you want to copy the password to the clipboard? (y/n): " copy_to_clipboard

if [[ $copy_to_clipboard == "y" ]]; then
    # Copy the password to the clipboard
    if command -v xclip >/dev/null 2>&1; then
        echo -n "$password" | xclip -selection clipboard
        echo "The password has been copied to the clipboard."
    elif command -v pbcopy >/dev/null 2>&1; then
        echo -n "$password" | pbcopy
        echo "The password has been copied to the clipboard."
    else
        echo "Copying to the clipboard requires either xclip or pbcopy command."
        echo "Please manually copy the password."
    fi
fi
