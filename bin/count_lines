#!/bin/bash

while [ $# -gt 0 ]; do
    case "$1" in
        --min)
            shift
            min_lines="$1"
            shift
            ;;
        -h | --help)
            echo "Usage: $(basename "$0") [--min N] [DIR]"
            echo "  --min N  Show only files with N or more lines"
            echo "  -h, --help  Show this help message"
            exit 0
            ;;
        *)
            root="$1"
            shift
            ;;
    esac
done

# default to the current directory
if [ -z "$root" ]; then
    root="."
fi

# count lines per file, longest first
find "$root" -type f -print0 | xargs -0 wc -l | sort -nr |
    awk -v min="$min_lines" '{if ($1 >= min || min == "") print}'
