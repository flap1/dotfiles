#!/bin/bash

# Ask about each exited container, one at a time.
containers=$(docker ps -a --filter "status=exited" --format "{{.Names}}")

for container in $containers; do
    echo "container: $container"
    read -r -p "remove it? (y/n): " answer

    if [[ $answer == "y" ]]; then
        docker rm "$container"
        echo "removed $container"
    else
        echo "kept $container"
    fi

    echo
done
