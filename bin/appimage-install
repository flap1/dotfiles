#!/bin/bash

show_help() {
    echo "Usage: $0 /path/to/appimage"
    echo "This script installs an AppImage and creates a desktop entry for it."
}

# no argument: print usage and stop
if [ -z "$1" ]; then
    show_help
    exit 1
fi

appimage_path=$1

if [ ! -f "$appimage_path" ]; then
    echo "AppImage not found: $appimage_path"
    exit 1
fi

appimages_dir="$HOME/appimages"
mkdir -p "$appimages_dir"

# move it in and make it executable
appimage_filename=$(basename "$appimage_path")
mv "$appimage_path" "$appimages_dir/$appimage_filename"
chmod +x "$appimages_dir/$appimage_filename"

cd "$appimages_dir" || exit 1

# a leftover squashfs-root would be extracted into
app_dir="squashfs-root"
if [ -d "$app_dir" ]; then
    read -r -p "Existing 'squashfs-root' directory found. Do you want to remove it? (y/n): " remove_dir
    if [ "$remove_dir" = "y" ]; then
        rm -r "$app_dir"
    else
        echo "Aborted."
        exit 1
    fi
fi

./"$appimage_filename" --appimage-extract

app_dir="squashfs-root"
if [ -z "$app_dir" ]; then
    echo "Failed to extract AppImage: $appimage_path"
    exit 1
fi

program_name=$(basename "$appimage_filename" | sed 's/\.AppImage$//')

if [ -d "$program_name" ]; then
    read -r -p "Existing '$program_name' directory found. Do you want to remove it? (y/n): " remove_dir
    if [ "$remove_dir" = "y" ]; then
        rm -r "$program_name"
    else
        echo "Aborted."
        exit 1
    fi
fi

mv "$app_dir" "$program_name"

user_name=$(whoami)

desktop_file=$(find "$appimages_dir/$program_name" -maxdepth 2 -type f -name "*.desktop")

if [ -z "$desktop_file" ]; then
    echo "Desktop file not found in $appimages_dir/$program_name"
    exit 1
fi

# point Exec= at the extracted binary
sed -i "s|Exec=.*|Exec=/home/$user_name/appimages/$appimage_filename|" "$desktop_file"

# pick an icon
icon_files=("$appimages_dir/$program_name"/*.png)

if [ ${#icon_files[@]} -gt 0 ]; then
    echo "Select an icon file:"

    index=0
    selected_icon_file=""
    for icon_file in "${icon_files[@]}"; do
        echo "[$index] $icon_file"
        index=$((index + 1))
    done

    read -r -p "Enter the number corresponding to the icon file: " selected_index

    selected_icon_file=${icon_files[selected_index]}

    if [ -n "$selected_icon_file" ]; then
        sed -i "s|Icon=.*|Icon=$selected_icon_file|" "$desktop_file"
    fi
fi

desktop-file-install --dir="$HOME/.local/share/applications" "$desktop_file"

update-desktop-database "$HOME/.local/share/applications"

echo "AppImage installed and desktop entry created."
