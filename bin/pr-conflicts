#!/bin/sh
# Which files conflict, across every open PR that's currently conflicting --
# the batch view of what pr-why shows one PR at a time. Reads the `conflict`
# label pr-conflict-labels.timer keeps in sync, so this is just a git
# merge-tree per already-known-conflicting PR, not a fresh mergeable check.
set -e

GH=$(command -v gh)
JQ=$(command -v jq)
[ -n "$GH" ] && [ -n "$JQ" ] || {
    echo "pr-conflicts needs gh and jq on PATH" >&2
    exit 1
}

prs=$("$GH" search prs --involves=@me --state=open --label=conflict \
    --json repository,number -L 100)

count=$(echo "$prs" | "$JQ" 'length')
[ "$count" = 0 ] && {
    echo "no conflicting PRs"
    exit 0
}

echo "$prs" | "$JQ" -c '.[]' | while IFS= read -r pr; do
    repo=$(echo "$pr" | "$JQ" -r '.repository.nameWithOwner')
    number=$(echo "$pr" | "$JQ" -r '.number')
    # search prs has no baseRefName field (unlike pr view) -- one extra call.
    base=$("$GH" pr view "$number" --repo "$repo" --json baseRefName -q '.baseRefName')

    printf '%s#%s -> %s\n' "$repo" "$number" "$base"

    r=$(ghq list --full-path -e "$repo" 2>/dev/null) || {
        printf '  (repo not cloned locally)\n\n'
        continue
    }
    git -C "$r" fetch -q origin "$base" 2>/dev/null || {
        printf '  (could not fetch -- check repo access)\n\n'
        continue
    }
    b=$(git -C "$r" rev-parse FETCH_HEAD)
    git -C "$r" fetch -q origin "pull/$number/head" 2>/dev/null || {
        printf '  (could not fetch PR head -- check repo access)\n\n'
        continue
    }
    h=$(git -C "$r" rev-parse FETCH_HEAD)
    # See pr-why for why this awk anchors on the tree-oid line.
    git -C "$r" merge-tree --write-tree --name-only "$b" "$h" 2>/dev/null |
        awk 'seen && /^$/ { exit } seen { print "  " $0 } /^[0-9a-f]{40}$/ { seen = 1 }' || true
    printf '\n'
done
