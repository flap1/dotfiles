#!/bin/sh
# Every live Claude session on this box, what it is doing, and what it wants
# from you -- with enter to move the tmux client to the one you picked.
#
#   claude-ls            picker with transcript preview, live-refreshing
#   claude-ls --print    the table once, for scripts and `watch claude-ls --print`
#   claude-ls --counts   "<state> <n>" per line, for the tmux status bar
#   claude-ls --rows     internal: raw rows for the picker's reload
#   claude-ls --header   internal: the picker's header for the same
#
# The picker is modal, the way a list you read is easier to drive than a search
# box you type into: j/k move, / or f opens the search, esc leaves it, esc again
# closes. fzf fires a single-character binding even while the input is visible,
# so the navigation keys have to be unbound on the way in and rebound on the way
# out -- the shape upstream settled on in junegunn/fzf#4215.
#
# Four sources, because no single one has all of it:
#   claude agents --json               who exists (pid, sessionId, cwd, name)
#   ~/.claude/sessions/<pid>.json      status + entrypoint, see state() below
#   ~/.claude/projects/*/<sid>.jsonl   transcript: the question, the title, the
#                                      last thing said, the time it was said
#   ~/.cache/claude-rate-limits.json   written by the statusline hook, the only
#                                      place the rate limits are exposed
#
# States, most-wanting-attention first:
#   ASK?   an AskUserQuestion is unanswered -- the question is in the last column
#   WAIT?  mid-turn but the process reports idle: parked on a permission prompt
#   busy   working
#   done   the turn ended with prose
#   gone?  mid-turn with nothing for half an hour: killed, or a dead tool call
set -eu

# zinit installs fzf, so it is only on PATH inside an interactive zsh. tmux's
# display-popup runs the command with the *server's* environment, where it is
# missing -- and a picker that cannot find its picker exits before it draws
# anything, which looks exactly like the popup refusing to open.
PATH="$PATH:$HOME/.local/share/zsh/zinit/plugins/junegunn---fzf"

mode=${1:-picker}
interval=5
stale_after=1800   # seconds before an unfinished turn is called gone?
nav='j,k,q,f,/'    # keys that only mean something while the input is hidden

esc=$(printf '\033')
r="$esc[0m"; dim="$esc[2m"; ylw="$esc[1;33m"; mag="$esc[1;35m"
grn="$esc[32m"; cyn="$esc[36m"
tab=$(printf '\t')
now=$(date +%s)

# ---------------------------------------------------------------- lookup

panes=$(tmux list-panes -a -F '#{pane_pid} #{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)

pane_of() {
  pid=$1
  while [ "$pid" -gt 1 ]; do
    target=$(printf '%s\n' "$panes" | awk -v p="$pid" '$1 == p { print $2; exit }')
    [ -n "$target" ] && { printf '%s' "$target"; return; }
    # field 4 of /proc/pid/stat is ppid; comm (field 2) can contain spaces, so
    # cut after the last ')' before splitting.
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return
    pid=$(printf '%s' "$stat" | sed 's/.*) //' | cut -d' ' -f2)
  done
}

transcript_of() {
  # Same sessionId can appear under several project slugs after a cd; newest wins.
  ls -t "$HOME/.claude/projects"/*/"$1.jsonl" 2>/dev/null | head -1
}

# "<epoch>\t<asking|working|done>\t<title>\t<summary>" for one transcript.
#
# 400 lines covers any single turn. The title is its own ai-title entry, rewritten
# whenever Claude renames the session, so the last one is the current one -- but
# it can sit far above the tail, hence the separate tac|grep in row().
#
# A live transcript is not always valid jsonl: concurrent appends leave runs of
# NUL where a line should be, so `jq -s` aborts on the whole file over one bad
# line. tr drops the NUL padding, `inputs | fromjson?` drops whatever is still
# unparseable, and the rest of the session still reads.
digest() {
  tail -n 400 "$1" 2>/dev/null | tr -d '\000' | jq -Rrn '
    [ inputs | fromjson? | select(.type == "assistant" or .type == "user") ] as $m
    | ( $m | last ) as $l
    | [ $m[] | .message.content[]? | select(.type == "tool_use") ] as $calls
    | [ $m[] | .message.content[]? | select(.type == "tool_result") | .tool_use_id ] as $answered
    | ( [ $calls[] | select(.name == "AskUserQuestion")
          | select(.id as $i | $answered | index($i) | not) ] | last ) as $ask
    | ( [ $l.message.content[]?
          | select(.type == "tool_use" or .type == "tool_result") ] | length > 0 ) as $mid
    | ( [ $m[] | select(.type == "assistant") | .message.content[]?
          | select(.type == "text") | .text ] | last ) as $said
    | [ ( [ $m[] | .timestamp // empty ] | last
          # fromdateiso8601 rejects the milliseconds these stamps carry.
          | if . then (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | tostring) else "0" end ),
        ( if $ask then "asking" elif $mid then "working" else "done" end ),
        ( ( if $ask
            then ( [ $ask.input.questions[]?
                     | .question + " ["
                       + ( [ .options[]?.label ] | join(" / ") ) + "]" ] | join("  ") )
            else ($said // "") end )
          | gsub("\\s+"; " ") | .[0:300] ) ]
    | @tsv'
}

# Which of busy / WAIT? / gone? an unfinished turn is.
#
# status is only maintained by entrypoint=cli sessions (claude-vscode ones never
# write it), so it can only ever confirm, never deny. A cli session that says
# idle while its transcript sits mid-turn is genuinely parked -- in practice on a
# permission prompt, which has no field of its own anywhere.
state() {
  kind=$1 status=$2 entry=$3 idle=$4
  case "$kind" in
    asking) printf 'ASK?'; return ;;
    done) [ "$status" = busy ] && printf 'busy' || printf 'done'; return ;;
  esac
  if [ "$idle" -gt "$stale_after" ]; then printf 'gone?'
  elif [ "$entry" = cli ] && [ "$status" != busy ]; then printf 'WAIT?'
  else printf 'busy'; fi
}

row() {   # pid sid cwd status -> one tab-separated row
  pid=$1 sid=$2 cwd=$3 status=$4

  # pane_of prints nothing (and still succeeds) when the process is not a
  # descendant of any pane. Rather than an anonymous "-", say where it does
  # live: a VS Code or remote-control session is not lost, it is elsewhere.
  entry=$(jq -r '.entrypoint // "?"' "$HOME/.claude/sessions/$pid.json" 2>/dev/null || echo '?')
  target=$(pane_of "$pid")
  case "${target:-}" in
    "") where=$(printf '%s' "$entry" | sed 's/^claude-//;s/^cli$/detached/') ;;
    *) where=$target ;;
  esac

  file=$(transcript_of "$sid")
  IFS="$tab" read -r at kind summary <<EOF
$([ -n "$file" ] && digest "$file")
EOF
  title=$(tac "$file" 2>/dev/null | tr -d '\000' | grep -am1 '"type":"ai-title"' |
          jq -r '(.aiTitle // "") | .[0:28]' 2>/dev/null || true)

  at=${at:-0}
  idle=$((now - at))
  [ "$at" = 0 ] && idle=0
  if [ "$at" = 0 ]; then age="?"
  elif [ "$idle" -lt 3600 ]; then age="$((idle / 60))m"
  elif [ "$idle" -lt 86400 ]; then age="$((idle / 3600))h"
  else age="$((idle / 86400))d"; fi

  # epoch rides along as a hidden column purely to sort within a state, newest
  # first -- age is a string and sorts like one.
  # name is dropped on purpose: it is only "<basename of cwd>-<2 hex of sid>",
  # so the cwd column already carries everything it says. The title identifies
  # the session to a human; the sid, hidden in column 1, identifies it to
  # anything else.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$sid" "$at" "$where" "$(state "${kind:-done}" "$status" "$entry" "$idle")" \
    "$age" "$cwd" "${title:-—}" "${summary:-—}"
}

rows() {
  # One digest per session is ~80ms of jq and tac; eight in sequence is a visible
  # stall on every refresh, so they run at once and are collected in order.
  d=$(mktemp -d)
  claude agents --json |
    jq -r '.[] | [.pid, .sessionId, (.cwd | sub("^" + $ENV.HOME; "~")),
                  (if .status then .status else "-" end)] | @tsv' |
    { i=0
      while IFS="$tab" read -r pid sid cwd status; do
        i=$((i + 1))
        row "$pid" "$sid" "$cwd" "$status" > "$d/$i" &
      done
      wait; }
  cat "$d"/* 2>/dev/null |
    LC_ALL=C sort -t "$tab" -k4,4 -k2,2nr   # ASK? WAIT? busy done gone?, newest first
  rm -rf "$d"
}

# Colour by state so the eye lands on the rows that want something. Applied after
# column -t: escape sequences would otherwise be counted as width.
paint() {
  awk -v f="$1" -v y="$ylw" -v m="$mag" -v g="$grn" -v d="$dim" -v r="$r" \
    '{ s = $f
       if (s == "ASK?") print y $0 r
       else if (s == "WAIT?") print m $0 r
       else if (s == "busy") print g $0 r
       else print d $0 r }'
}

# ---------------------------------------------------------------- header

# `claude auth status` spawns node and costs the better part of a second, and it
# answers with something that changes about never -- too slow to sit on the
# picker's five-second header refresh, so it is kept on disk for an hour.
account() {
  cache="$HOME/.cache/claude-ls-account"
  # find prints nothing for a file that is missing as well as one that is stale,
  # which is the same answer as far as this is concerned.
  if [ -z "$(find "$cache" -mmin -60 2>/dev/null)" ]; then
    acct=$(claude auth status --json 2>/dev/null |
      jq -r '"\(.email // "?") \(.subscriptionType // "?")\(if .orgName then " @" + .orgName else "" end)"' \
      2>/dev/null || true)
    # Only a real answer is worth caching: an empty one would be repeated for an
    # hour rather than retried on the next refresh.
    if [ -n "$acct" ]; then printf '%s\n' "$acct" > "$cache"; fi
  fi
  acct=$(cat "$cache" 2>/dev/null || true)
  printf '%s' "${acct:-not logged in}"
}

header() {
  limits=$(jq -r --argjson now "$now" '
      def pct: if . == null then "?" else (floor | tostring) + "%" end;
      def left: if . == null then "" else
        (. - $now) as $d
        | if $d <= 0 then " reset" else
            " " + (if $d >= 86400 then (($d / 86400) | floor | tostring) + "d" else "" end)
                + ((($d % 86400) / 3600) | floor | tostring) + "h"
                + ((($d % 3600) / 60) | floor | tostring) + "m"
          end end;
      "5h " + (.five_hour.used_percentage | pct) + (.five_hour.resets_at | left)
      + "   7d " + (.seven_day.used_percentage | pct) + (.seven_day.resets_at | left)' \
    "$HOME/.cache/claude-rate-limits.json" 2>/dev/null ||
    echo 'limits: unknown until a session renders its statusline')

  printf '%s%s   %s%s\n' "$cyn" "$(account)" "$limits" "$r"
}

picker_header() {
  header
  printf '%s%s%s\n' "$dim" \
    'j/k move   / search   enter jump   ctrl-d/u scroll   ctrl-a agents   q close' "$r"
}

# ---------------------------------------------------------------- modes

# --header is the one mode that wants no rows, and it is the one the picker runs
# every few seconds -- so it answers before the expensive part.
if [ "$mode" = --header ]; then
  picker_header
  exit 0
fi

all=$(rows)

# cut -f1-7 drops the last-message column in the picker: the preview underneath
# shows the conversation itself, so the column only repeated its final line.
# --print keeps it, having no preview to lean on.
case "$mode" in
  --rows)
    # sid and epoch stay as leading columns: the picker hides them and feeds the
    # sid to the preview, so state is two fields right of where table() has it.
    printf '%s\n' "$all" | cut -f1-7 | column -t -s "$tab" | paint 4
    exit 0 ;;
  --print)
    header
    printf '%s\n' "$all" | cut -f3- | column -t -s "$tab" | paint 2
    exit 0 ;;
  --counts)
    # "<state> <n>" per line, for the tmux status bar. A machine-readable mode
    # rather than letting the caller re-split --rows: that output is aligned
    # and painted for a human, so parsing it would tie the bar to the table's
    # column widths.
    printf '%s\n' "$all" | cut -f4 | sort | uniq -c | awk '{ print $2, $1 }'
    exit 0 ;;
esac

# ---------------------------------------------------------------- picker

# Helper bodies live in files so fzf hands them to sh: inline, the user's login
# shell expands them, and zsh aborts an unmatched glob with "no match found".
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cat > "$tmp/preview" <<'PREVIEW'
#!/bin/sh
f=$(ls -t "$HOME/.claude/projects"/*/"$1.jsonl" 2>/dev/null | head -1)
[ -z "$f" ] && { echo "(no transcript yet)"; exit 0; }
# Runs of tool calls collapse into one dim line: reading "Bash / tool_result"
# forty times says nothing, "Bashx6 Edit" says what the turn did. An unanswered
# question is repeated at the top, where it cannot scroll away.
tail -n 4000 "$f" | tr -d '\000' | jq -Rrn '
  def dim: "[2m" + . + "[0m";
  [ inputs | fromjson? | select(.type == "assistant" or .type == "user") ] as $m
  | ( [ $m[] | .message.content[]? | select(.type == "tool_result") | .tool_use_id ] ) as $answered
  | ( [ $m[] | .message.content[]? | select(.type == "tool_use")
        | select(.name == "AskUserQuestion")
        | select(.id as $i | $answered | index($i) | not) ] | last ) as $ask
  | ( if $ask then
        [ "[1;33mwaiting on you[0m",
          ( $ask.input.questions[]?
            | "  " + .question
              + ( [ .options[]? | "\n      - " + .label
                    + (if .description then "  " + (.description | .[0:120] | dim) else "" end) ]
                  | join("") ) ),
          "" ]
      else [] end ) as $head
  | ( [ $m[]
        | (if (.message.content | type) == "string"
           then { k: (if .type == "user" then "u" else "a" end), s: .message.content }
           else
             ([ .message.content[]? | select(.type == "text") | .text ] | join(" ")) as $t
           | ([ .message.content[]? | select(.type == "tool_use") | .name ]) as $n
           | if ($t | length) > 0
             then { k: (if .type == "user" then "u" else "a" end), s: $t }
             else { k: "t", s: ($n | join(",")) } end
           end) ]
      | reduce .[] as $x ([];
          if $x.k == "t" and (.[-1].k? == "t")
          then .[0:-1] + [ { k: "t", s: (.[-1].s + "," + $x.s) } ]
          else . + [$x] end)
      | map(if .k == "t"
            then { k: "t", s: ( .s | split(",") | map(select(. != ""))
                                | group_by(.)
                                | map(.[0] + (if length > 1 then "x" + (length | tostring) else "" end))
                                | join(" ") ) }
            else . end)
      | .[-120:]
      | map( (.s | gsub("\\s+"; " ")) as $s
             | if .k == "u" then "[1;36myou[0m     " + ($s | .[0:2000])
               elif .k == "a" then "[1;32mclaude[0m  " + ($s | .[0:2000])
               else ("        " + (if $s == "" then "(tool)" else $s end) | dim) end ) ) as $body
  | ($head + $body)[]' 2>/dev/null
PREVIEW

# Enter moves the client to the row's pane and closes the popup -- you go there to
# work, and a list left on top of where you just landed only hides it. It prints
# the action for fzf to run rather than aborting from the binding, so that a row
# with nowhere to jump to (vscode, detached) leaves the list up instead of closing
# on a move that did not happen.
cat > "$tmp/jump" <<'JUMP'
#!/bin/sh
t=$1

# switch-client has to be told which client to move. A popup is not a pane, so it
# carries no TMUX_PANE, and without one tmux falls back to whichever client it saw
# activity on last -- with a second terminal attached that is regularly the other
# one, and the jump happens over there. The binding cannot pass the client in
# either: display-popup expands no format in -e or in its command.
#
# What the popup does carry is $TMUX, whose third field is the session id it was
# opened from. The client attached to that session is the one that opened it. Two
# clients on one session are showing the same window anyway, so either will do.
c=$(tmux list-clients -F '#{client_tty} #{session_id}' 2>/dev/null |
    awk -v s="\$${TMUX##*,}" '$2 == s { print $1; exit }')

case "$t" in
  *:*.*) tmux switch-client ${c:+-c "$c"} -t "${t%%:*}" \; select-window -t "${t#*:}" \; select-pane -t "$t" &&
         echo abort ;;
  *) exit 0 ;;   # vscode / detached / no pane: nothing to switch to
esac
JUMP

# fzf has no timer event, so refreshing is pushed in from outside over the
# --listen port, which fzf exports to action children as $FZF_PORT. The header
# goes with the rows: its rate-limit countdown is the part of this screen that
# rots fastest, and a popup left open all afternoon would keep quoting the
# figures it opened with.
cat > "$tmp/refresh" <<'REFRESH'
#!/bin/sh
[ -n "${FZF_PORT:-}" ] || exit 0
while sleep "${1:-5}"; do
  # $0 lives in the picker's tmpdir, which its EXIT trap removes -- the cheapest
  # liveness check there is. A failing curl alone was not enough: the loop
  # outlived fzf in practice.
  [ -e "$0" ] || exit 0
  curl -s -XPOST "localhost:$FZF_PORT" \
       -d "reload(claude-ls --rows)+transform-header(claude-ls --header)" \
       >/dev/null || exit 0
done
REFRESH
chmod +x "$tmp/preview" "$tmp/jump" "$tmp/refresh"

# follow pins the preview to the end of its output: the newest message is the
# last line, and without it every session opens showing its oldest.
#
# The esc binding ends on search(): hide-input disables searching as well as
# hiding it, and a disabled search never re-runs, so clearing the query alone
# would leave the last filter's result on screen with nothing to explain it.
printf '%s\n' "$all" | cut -f1-7 | column -t -s "$tab" | paint 4 |
  fzf --ansi --reverse --with-nth=3.. --no-input \
      --header "$(picker_header)" \
      --preview-window=down,65%,wrap,follow \
      --preview "$tmp/preview {1}" \
      --listen \
      --bind "start:execute-silent($tmp/refresh $interval &)" \
      --bind "enter:transform($tmp/jump {3})" \
      --bind 'j:down,k:up,q:abort' \
      --bind "f:show-input+unbind($nav)" \
      --bind "/:show-input+unbind($nav)" \
      --bind "esc:transform:[ \"\$FZF_INPUT_STATE\" = enabled ] \
                            && echo 'rebind($nav)+clear-query+hide-input+search()' \
                            || echo abort" \
      --bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up' \
      --bind 'ctrl-a:execute(claude agents)' \
      --bind 'ctrl-r:reload(claude-ls --rows)+transform-header(claude-ls --header)'
