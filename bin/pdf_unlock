#!/bin/bash

usage() {
    cat <<EOF
Usage:
    $(basename "${0}") [path/to/pdf] [password]

Options:
    --help, -h        print this
EOF
}

case $1 in
    help | --help | -h)
        usage
        ;;
    *)
        # The output goes beside the input, not into "_dir/file.pdf", which is
        # what prefixing the whole path produced.
        qpdf --password="$2" --decrypt "$1" "$(dirname -- "$1")/_$(basename -- "$1")"
        ;;
esac
