#!/bin/bash

# Shows you the largest objects in your repo's pack file.

# Set the internal field separator to line break, so that we can iterate easily over the verify-pack output
IFS=$'\n';

# List all objects including their size, sort by size, take top 20
objects=$(git verify-pack -v .git/objects/pack/pack-*.idx | grep -v chain | sort -k3nr | head -n 20)

echo "All sizes are in MBs. The pack column is the size of the object, compressed, inside the pack file."

# Print the table header
printf "%-8s %-8s %-40s %s\n" "Size" "Pack" "SHA" "Location"

for object in $objects
do
	# Extract the size in bytes
	size=$(( $(echo "$object" | cut -f 5 -d ' ') / 1024 / 1024))
	# Extract the compressed size in bytes
	compressedSize=$(( $(echo "$object" | cut -f 6 -d ' ') / 1024 / 1024))
	# Extract the SHA
	sha=$(echo "$object" | cut -f 1 -d ' ')
	# Find the object's location in the repository tree
	other=$(git rev-list --all --objects | grep "$sha")
	
	# Print the object details in a formatted manner
	printf "%-8s %-8s %-40s %s\n" "${size}M" "${compressedSize}M" "$other"
done

