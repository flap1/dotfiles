#!/bin/sh
# Run the agent picker with a steady cursor and restore it on exit.

set -eu

restore_cursor() {
    # Ps=0 falls back to the terminal's own default, which is blinking on
    # most emulators — not "restore", a silent switch to blink on exit.
    printf '\033[2 q'
}
trap restore_cursor EXIT HUP INT TERM

# DECSCUSR 2: steady block. fzf keeps its input cursor visible even while the
# picker is in navigation mode; making it steady avoids localized flicker.
printf '\033[2 q'
"$HOME/.local/share/agent-ui/scripts/tmux-agent-status.sh" popup
