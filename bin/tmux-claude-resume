#!/usr/bin/env bash
# tmux-resurrect post-save-layout hook; the argument is the state file just
# written. Rewrites the restore command of a claude pane into
# `claude --resume <sessionId>`, because resurrect saves the cmdline and a bare
# `claude` would restore into a new conversation.
#
# Panes are matched by the pgid of the pid in `claude agents --json` against
# the pane's tpgid, the tty's foreground process group. A claude running under
# a wrapper still shares the group, so it matches; a claude outside tmux (the
# VSCode extension, say) matches no pane. Nothing has to wrap the launch, and
# resuming by sessionId means nothing is derived from a name.
#
# Stateless: read from the live processes every time.
set -eu

state=${1:?usage: tmux-claude-resume <resurrect state file>}
[ -f "$state" ] || exit 0

tab=$(printf '\t')

# comm in /proc/<pid>/stat can contain spaces and parentheses, so only the
# text after the last ')' is parsed: f3=pgrp, f6=tpgid.
stat_field() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f"$2"; }

# "<tpgid>\t<session>\t<window>\t<pane>"
pane_groups=$(
    tmux list-panes -a -F "#{pane_pid}$tab#{session_name}$tab#{window_index}$tab#{pane_index}" |
        while IFS="$tab" read -r pid session window index; do
            tpgid=$(stat_field "$pid" 6) || continue
            [ -n "$tpgid" ] && [ "$tpgid" -gt 0 ] || continue
            printf '%s\t%s\t%s\t%s\n' "$tpgid" "$session" "$window" "$index"
        done
)
[ -n "$pane_groups" ] || exit 0

# Keep every argument except the ones that conflict with --resume:
# --session-id, --continue and --name (--name also eats its value; -c is
# claude's short form of --continue). Restore goes through send-keys into a
# shell, so what is kept is quoted with %q. Background agents are children of
# claude and share its pgid, so without filtering by kind they take the
# parent's pane.
resume_command() {
    local pid=$1 sid=$2 argv=() args=() skip=0 a
    mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null || return 1
    for a in "${argv[@]:1}"; do
        if [ "$skip" = 1 ]; then
            skip=0
            continue
        fi
        case $a in
            --resume | --session-id | --name)
                skip=1
                continue
                ;;
            --resume=* | --session-id=* | --name=*) continue ;;
            --continue | -c) continue ;;
        esac
        args+=("$a")
    done
    if [ "${#args[@]}" -gt 0 ]; then
        printf 'claude --resume %s %s\n' "$sid" "$(printf '%q ' "${args[@]}")"
    else
        printf 'claude --resume %s\n' "$sid"
    fi
}

claude_map=$(
    claude agents --json 2>/dev/null |
        jq -r '.[] | select(.kind == "interactive") | [.pid, .sessionId] | @tsv' |
        while IFS="$tab" read -r pid sid; do
            pgid=$(stat_field "$pid" 3) || continue
            key=$(printf '%s\n' "$pane_groups" | awk -F"$tab" -v g="${pgid:-0}" -v OFS="$tab" \
                '$1 == g { print $2, $3, $4; exit }')
            [ -n "$key" ] || continue
            command=$(resume_command "$pid" "$sid") || continue
            printf '%s\t%s\n' "$key" "${command% }"
        done
)
[ -n "$claude_map" ] || exit 0

# A pane line in the state file is f1=pane f2=session f3=window f6=pane_index,
# with f11 holding ":<command to restore>". Values are passed through the
# environment rather than -v because awk interprets escapes in a -v assignment
# and eats the backslashes of the quoting.
CLAUDE_MAP=$claude_map awk -F"$tab" -v OFS="$tab" '
	BEGIN {
		n = split(ENVIRON["CLAUDE_MAP"], lines, "\n")
		for (i = 1; i <= n; i++) {
			if (split(lines[i], f, "\t") != 4) continue
			cmd[f[1] OFS f[2] OFS f[3]] = f[4]
		}
	}
	$1 == "pane" && (($2 OFS $3 OFS $6) in cmd) { $11 = ":" cmd[$2 OFS $3 OFS $6] }
	{ print }
' "$state" >"$state.tmp" && mv "$state.tmp" "$state"
