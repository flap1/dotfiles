evdev:atkbd:dmi:bvn*:bvr*:bd*:svn*:pn*:pvr* # 
 KEYBOARD_KEY_b8=grave # rightalt to zenkakuhankaku
 KEYBOARD_KEY_3a=leftctrl # capslock to leftctrl
 KEYBOARD_KEY_79=backspace # henkan to backspace
 KEYBOARD_KEY_7b=esc # muhenkan to esc
 # at Mozc Setting: katakana -> disable ime, hiragana -> enable ime

## memo
# b8 rightalt
# 1d leftctrl
# 0e backspace
# 29 grave(zenkakuhankaku)
# 01 esc
# 70 katakanahiragana
# 79 henkan
# 7b muhenkan
# 3a capslock
