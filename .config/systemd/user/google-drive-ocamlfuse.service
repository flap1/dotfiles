[Unit]
Description=FUSE filesystem over Google Drive
# The mount needs a network that is up, not merely configured.
After=network-online.target
Wants=network-online.target

[Service]
# A user unit rather than a system one: the mount belongs to a single user's
# session and its credentials live in that user's home. As a system unit it had
# to name the user twice (User=/Group=) and spell out /home/<user> in ExecStart,
# which broke on any other account. %h needs no such assumption.
Type=forking
ExecStart=/bin/bash -c 'mkdir -p %h/gdrive/m && exec google-drive-ocamlfuse %h/gdrive/m'
ExecStop=/bin/bash -c 'fusermount -u %h/gdrive/m'
# on-failure, not always: a deliberate unmount should stay unmounted instead of
# being fought by the restart loop.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
