[user]
	name = flap1
	email = sho1seto@gmail.com

[init]
	defaultBranch = main
	templatedir = ~/.git_template

[pull]
	rebase = true
	default = current

[core]
    pager = delta
    editor = nvim
    hooksPath = ~/.git_template/hooks

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
    s = status -sb
    cm = commit
    cme = commit --allow-empty
    co = checkout
    br = branch --verbose --color --sort=-authordate
    d = diff
    dc = diff --cached -U2
    rh = reset --soft HEAD .
    p = !git push origin `git rev-parse --abbrev-ref HEAD`
    go = "switch -c"
    dm = "!git branch --merged | grep -v main | grep -v master | grep -v '*' | xargs -n 1 git branch -d"
    please = push --force-with-lease
    uncommit = reset --mixed HEAD~
    refrech = fetch --prune
    sync = !git checkout $(git remote show origin | grep 'HEAD branch' | awk '{print $NF}') && git pull
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    l = log --oneline --graph --decorate -n 10

[url "ssh://git@"]
    insteadOf = https://

[include]
    path = .gitconfig.local

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[push]
	autoSetupRemote = true
[safe]
	directory = /srv/redacted-org/gha-runner-deploy/
	directory = /srv/redacted-org/gha-runner-deploy/_work/redacted-org-deploy/
	directory = /srv/redacted-org/gha-runner-deploy/_work/redacted-org-deploy/redacted-org-deploy
	directory = /srv/redacted-org/redacted-org-ci

[commit]
	gpgsign = false
[credential "https://gitlab.com"]
	helper = 
	helper = !/home/flap1/.local/share/mise/installs/glab/1.109.0/bin/glab auth git-credential
[url "git@key-REDACTED.github.com:redacted-org/redacted-org-platform"]
	insteadOf = https://github.com/redacted-org/redacted-org-platform
	insteadOf = git@github.com:redacted-org/redacted-org-platform
	insteadOf = ssh://git@github.com/redacted-org/redacted-org-platform
[url "git@key-REDACTED.github.com:redacted-org/redacted-org-topics"]
	insteadOf = https://github.com/redacted-org/redacted-org-topics
	insteadOf = git@github.com:redacted-org/redacted-org-topics
	insteadOf = ssh://git@github.com/redacted-org/redacted-org-topics
