# No [user] section here on purpose. This repo is public, and an identity baked
# into it means anyone who clones and links it commits as its author until they
# notice. Set name and email in ~/.gitconfig.local, which is included further
# down.

[init]
	defaultBranch = main
	# New repos only. Never core.hooksPath: that would replace hooks in
	# every clone on this machine, including other people's lefthook.
	templatedir = ~/.git_template

[pull]
	rebase = true
	default = current

[core]
    pager = delta
    editor = nvim

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true

[merge]
    # git 2.35. Unknown conflictstyle is fatal on clone, not only on merge.
    # packages/system.sh will not leave an older git installed.
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    # histogram produces smaller, more readable hunks than the default myers,
    # which matters most when reviewing machine-generated changes.
    algorithm = histogram

# Record how a conflict was resolved and replay it automatically the next time
# the same conflict appears. Parallel agents on worktrees rebase constantly and
# hit the same conflict repeatedly; this makes it a one-time cost.
[rerere]
    enabled = true
    autoUpdate = true

[absorb]
    # In an agent flow you rarely stage by hand, so `git absorb` should just
    # take the working tree.
    autoStageIfNothingStaged = true

# Structural diff, on demand. `git dt` shows what changed semantically, with
# pure reformatting collapsed away. Same tool lazygit cycles to with `|`.
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[alias]
    s = status -sb
    cm = commit
    cme = commit --allow-empty
    co = checkout
    br = branch --verbose --color --sort=-authordate
    d = diff
    dc = diff --cached -U2
    rh = reset --soft HEAD .
    p = push
    go = "switch -c"
    please = push --force-with-lease
    uncommit = reset --mixed HEAD~
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    l = log --oneline --graph --decorate -n 10
    # Structural diff (difftastic) instead of line diff.
    dt = -c diff.external=difft diff
    # The review diff: what this branch does to main, as one change.
    # This is the diff a human reads before approving, not the per-commit one.
    review = "!git diff $(git merge-base HEAD ${1:-main})...HEAD #"
    # Same, structurally.
    reviewt = "!git -c diff.external=difft diff --ext-diff $(git merge-base HEAD ${1:-main})...HEAD #"

# Identity, deploy-key hosts, credential helpers: ~/.gitconfig.local (untracked).
[include]
    path = ~/.gitconfig.local

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[push]
	autoSetupRemote = true
[commit]
	gpgsign = false
