}

@ARTICLE{Elallaoui2018-tj,
  title    = "Automatic Transformation of User Stories into {UML} Use Case
              Diagrams using {NLP} Techniques",
  author   = "Elallaoui, Meryem and Nafil, Khalid and Touahni, Raja",
  abstract = "Agile methods in general and the Scrum method in particular are
