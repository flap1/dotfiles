@ARTICLE{Zhu2022-ra,
  title         = "{Multi-Modal} Knowledge Graph Construction and Application:
                   A Survey",
  author        = "Zhu, Xiangru and Li, Zhixu and Wang, Xiaodan and Jiang,
                   Xueyao and Sun, Penglei and Wang, Xuwu and Xiao, Yanghua and
                   Yuan, Nicholas Jing",
  abstract      = "Recent years have witnessed the resurgence of knowledge
                   engineering which is featured by the fast growth of
                   knowledge graphs. However, most of existing knowledge graphs
                   are represented with pure symbols, which hurts the machine's
                   capability to understand the real world. The
                   multi-modalization of knowledge graphs is an inevitable key
                   step towards the realization of human-level machine
                   intelligence. The results of this endeavor are Multi-modal
                   Knowledge Graphs (MMKGs). In this survey on MMKGs
                   constructed by texts and images, we first give definitions
                   of MMKGs, followed with the preliminaries on multi-modal
                   tasks and techniques. We then systematically review the
