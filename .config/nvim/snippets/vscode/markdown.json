{
    "star_count": {
        "prefix": "star_count",
        "description": "Add the star count badge",
        "body": [
            "[![](https://img.shields.io/github/stars/${1:repo-path}?label=%20&logo=%20)]()"
        ]
    },
    "zenn_notice": {
        "prefix": "zenn_notice",
        "description": "zenn notice message",
        "body": [
            ":::message",
            "${1}",
            ":::"
        ]
    },
    "zenn_warning": {
        "prefix": "zenn_warning",
        "description": "zenn warning message",
        "body": [
            ":::message alert",
            "${1}",
            ":::"
        ]
    },
    "zenn_toggle": {
        "prefix": "zenn_toggle",
        "description": "zenn accordion toggle",
        "body": [
            ":::details ${1:title}",
            "${2:contents}",
            ":::"
        ]
    },
    "disable_lint": {
        "prefix": "disable_lint",
        "description": "Disable markdown lint",
        "body": [
            "<!-- markdownlint-disable MD013 MD034 -->"
        ]
    },
    "link": {
        "prefix": "link",
        "body": "[$1]($2){:target=_blank}",
        "description": "external link"
    },
    "exlink": {
        "prefix": "exlink",
        "body": "{:target=_blank}"
    },
    "import": {
        "prefix": "import",
        "body": "--8<-- '$1'",
        "description": "MkDocs file import"
    },
    "code": {
        "prefix": "code",
        "body": "```$1 title='$2'\n$3```",
        "description": "code fence"
    },
    "bash": {
        "prefix": "bash",
        "body": "```bash\n$1\n```",
        "description": "code fence"
    },
    "py": {
        "prefix": "py",
        "body": "```py\n$1\n```",
        "description": "code fence"
    },
    "ipy": {
        "prefix": "ipy",
        "body": "`#!py $1`",
        "description": "inline Python code"
    },
    "icode": {
        "prefix": "icode",
        "body": "`$1`",
        "description": "inline code"
    }
}
