{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read(**)"
    ]
  },
  "model": "opus[1m]",
  "effortLevel": "medium",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jk": "<Esc>"
  },
  "hooks": {
    "SessionStart": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh track claude" },
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh set idle claude" }
    ] }],
    "UserPromptSubmit": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh start claude event" }
    ] }],
    "PreToolUse": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh heartbeat claude event" }
    ] }],
    "PostToolUse": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh heartbeat claude event" }
    ] }],
    "PostToolUseFailure": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh heartbeat claude event" }
    ] }],
    "PermissionRequest": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh set permission claude" }
    ] }],
    "Stop": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh set idle claude" }
    ] }],
    "SessionEnd": [{ "hooks": [
      { "type": "command", "command": "$HOME/.local/share/shonenm-dotfiles/scripts/tmux-claude-pane.sh clear" }
    ] }]
  }
}
