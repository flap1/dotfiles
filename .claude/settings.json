{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git stash)",
      "Bash(git merge origin/develop --no-edit)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(docker compose:*)",
      "Bash(npm view:*)",
      "WebSearch",
      "WebFetch",
      "Read(**)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "codex@openai-codex": true,
    "context-mode@context-mode": false,
    "typescript-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "🐇 Dashing",
      "🐿️ Scurrying",
      "🦔 Waddling",
      "🦦 Diving",
      "🐊 Charging",
      "🦊 Sneaking",
      "🐹 Scampering",
      "🦎 Skittering",
      "🦡 Burrowing",
      "🦛 Charging",
      "🦒 Striding",
      "🐃 Stampeding",
      "🐐 Climbing",
      "🐟 Darting",
      "🦞 Scuttling",
      "🦀 Scuttling",
      "🦕 Lumbering",
      "🦖 Stomping",
      "🦆 Splashing",
      "🐓 Strutting",
      "🦌 Galloping",
      "🐘 Stomping",
      "🦈 Zooming",
      "🐢 Crawling",
      "🐆 Sprinting",
      "🦓 Galloping",
      "🦘 Bounding",
      "🦙 Trotting"
    ]
  },
  "effortLevel": "medium",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jk": "<Esc>"
  },
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
